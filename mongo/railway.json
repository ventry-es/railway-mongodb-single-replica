{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "restartPolicyType": "ALWAYS",
    "requiredMountPath": "/data",
    "numReplicas": 1,
    "drainingSeconds": 30,
    "overlapSeconds": 0
  }
}
