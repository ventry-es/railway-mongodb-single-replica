# Local development only — copy to .env and run `docker compose up`.
#
#   cp .env.example .env
#
# These values are committed on purpose so the local node works out of the box.
# They are public. Never reuse them anywhere that matters: on Railway the
# password is generated per deployment by the template.
#
# There is no keyfile to configure: the node generates its own on first boot
# and keeps it on the volume.

MONGO_REPLICA_SET_NAME=rs0
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=localdevpassword
